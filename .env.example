# Transactional email (https://resend.com). Without this the forms still
# validate and return success, and the payload is logged server-side instead.
RESEND_API_KEY=

# Verified sender on your Resend domain.
MAIL_FROM="VNT GROUP <noreply@vntgroup.co.jp>"

# Where enquiries land. Comma-separate for several recipients.
MAIL_TO=info@vntgroup.co.jp
